{
  "name": "finance-backend-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "Manual-first personal finance and daily budget MVP backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:sync": "tsx src/dbSync.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
